# Copia este archivo a .env y ajusta los valores.
ENV=development
DEBUG=true

# SQLite (desarrollo) o PostgreSQL (producción)
DATABASE_URL=sqlite:///./protipster.db

SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== DATOS REALES =====
# Clave gratuita de The Odds API (https://the-odds-api.com/).
# Con solo esta clave ya traes partidos reales + cuotas:
ODDS_API_KEY=

# Opcionales (no hacen falta para empezar):
API_FOOTBALL_KEY=
SPORTRADAR_KEY=
THESPORTSDB_KEY=3

# Motor
DEFAULT_EDGE_THRESHOLD=0.03
DEFAULT_MAX_EXPOSURE_PCT=0.05
