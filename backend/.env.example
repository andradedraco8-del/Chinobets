# Copia este archivo a .env y ajusta los valores.
ENV=development
DEBUG=true

# SQLite (desarrollo) o PostgreSQL (producción)
DATABASE_URL=sqlite:///./protipster.db
# DATABASE_URL=postgresql+psycopg2://protipster:protipster@localhost:5432/protipster

REDIS_URL=redis://localhost:6379/0

SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# APIs deportivas (opcionales)
API_FOOTBALL_KEY=
ODDS_API_KEY=
SPORTRADAR_KEY=
THESPORTSDB_KEY=3

# Motor
DEFAULT_EDGE_THRESHOLD=0.03
DEFAULT_MAX_EXPOSURE_PCT=0.05
